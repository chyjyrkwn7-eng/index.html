# Python bytecode, produced whenever a tools/ script is imported rather than
# run directly (the icon generator gets imported by ad-hoc comparison
# scripts). Nothing in here belongs in the repo.
__pycache__/
*.pyc

# Screenshots written by tools/shoot-flow.py (and anything else pointed at
# SHOOT_OUT). Regenerated on every run, ~130MB a time, and nothing at runtime
# reads them - they exist to be looked at once and sent on.
tools/walk/

# GIFs written by tools/record-cutscenes.py. Same reasoning as tools/walk/:
# regenerated on demand, several MB each, looked at once and sent on.
recordings/

# SERVICE ACCOUNT KEYS. THIS REPO IS PUBLIC - Pages will not serve a
# private one on a free plan - so a key committed here is full read/write
# admin on every classmate's data, published, permanently, and still in
# the history after it is deleted. The key belongs in the environment
# (NOVA_ADMIN_KEY) or in a file outside the repo (NOVA_ADMIN_KEY_FILE);
# these patterns are the net under that, not the plan.
*service-account*.json
*serviceaccount*.json
*-adminsdk-*.json
nova-admin-key.json
admin-key.json
*.pem
